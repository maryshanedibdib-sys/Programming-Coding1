#include <stdio.h>

int main() {

    char travClass;
    float bagWeight, bagAll, baseFare;

    //Travel Class Economy
    
    printf("Enter Travel Class Economy (E-conomy/B-usiness):");
    scanf(" %c", &travClass);

    if (travClass == 'E' || travClass == 'e') {
        printf("Travel Class: Economy\n");
    }
    else if(travClass == 'B' || travClass == 'b') {
        printf("Travel Class: Business\n");
    }
    else {
        printf ("Invalid Class Travel!");
